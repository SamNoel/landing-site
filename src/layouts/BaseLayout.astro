---
import "@styles/globals/defaults.css";
import "@styles/globals/tokens.css";
import "@styles/globals/responsive.css";
import "@styles/classes/color.css";
import "@styles/classes/spacing.css";
import "@styles/classes/animations.css";
import "@styles/classes/direction.css";
import "@styles/components/compounds/components.css";
import "@styles/components/containers/containers.css";
import "@styles/components/elements/elements.css";
import "@styles/components/families/families.css";

import Header from "@components/compounds/Header.astro";
import Footer from "@components/compounds/Footer.astro";
import Head from "@components/elements/Head.astro";

const { title, description } = Astro.props;
---

<html lang="en">
  <Head title={title} description={description} />
  <body class="bg-main">
    <Header />
    <slot />
    <Footer />
    <script>
      import "../scripts/animations.js";

      // this creates the Cloudflare tracking beacon only AFTER page load
      window.addEventListener("load", () => {
        const script = document.createElement("script");
        script.src = "https://static.cloudflareinsights.com/beacon.min.js";
        script.defer = true;
        script.setAttribute(
          "data-cf-beacon",
          JSON.stringify({ token: "c5cac76170194ddaaedc0c2d76ea4771" }),
        );
        document.body.appendChild(script);
      });
    </script>
  </body>
</html>
