---
import BaseLayout from "@layouts/BaseLayout.astro";
import Hero from "@components/families/Hero.astro";
import SectionContainer from "@components/containers/SectionContainer.astro";
import Stack from "@components/elements/Stack.astro";
import Card from "@components/compounds/Card.astro";
import { getAbout } from "@data/about.tsx";
import { getServices } from "@data/services.tsx";
import PageContainer from "@components/containers/PageContainer.astro";
import Heading from "@components/elements/Heading.astro";
import Text from "@components/elements/Text.astro";
import Spacer from "@components/elements/Spacer.astro";
import ContactForm from "@components/forms/ContactForm.astro";
import Grid from "@components/elements/Grid.astro";
import ResponsiveImage from "@components/elements/ResponsiveImage.astro";
import AnimationElement from "@components/elements/AnimationElement.astro";
import AnimationText from "@components/elements/AnimationText.astro";

const aboutContent = await getAbout();
const serviceContent = await getServices();
---

<BaseLayout title="Home">
  <PageContainer id="home" class="homepage-container">
    <ResponsiveImage
      desktopImgUrl={"background-new.png"}
      mobileImgUrl={"background-new-mobile.png"}
      alt="An image of the Noel Web Studio logo."
      desktopClassNames="desktop-hero"
      mobileClassNames="mobile-hero"
    />
    <SectionContainer width="wide">
      <Hero />
    </SectionContainer>

    <!-- <Spacer />

    <SectionContainer class="about-section fade-in-out-on-scroll" id="about">
      <Stack flex="row" gap="sm" justify="center" align="start">
        <Heading titleSize="h2">{aboutContent.title}</Heading>
        <div><aboutContent.Content /></div>
      </Stack>
    </SectionContainer> -->

    <Spacer />

    <SectionContainer className="about-section " vpadding="lg" id="about">
      <Stack flex="column" gap="lg" justify="center" align="center">
        <Stack flex="column" gap="sm" justify="center" align="center">
          <Heading titleSize="h2" align="center"
            ><AnimationElement
              >Fast, custom websites that actually convert.</AnimationElement
            ></Heading
          >
          <AnimationText delayValue={1} align="center"
            >We know that the web can be an overwhelming place for many
            businesses. At Noel Web Studio, our aim is to be your long-term web
            partner and deliver you a fast website and get more people finding
            your business online.</AnimationText
          >
        </Stack>
        <Grid>
          <AnimationElement delayValue={2}>
            <Card
              title={serviceContent[0].title}
              text={serviceContent[0].text}
            /></AnimationElement
          >
          <AnimationElement delayValue={3}>
            <Card
              title={serviceContent[1].title}
              text={serviceContent[1].text}
            /></AnimationElement
          >
          <AnimationElement delayValue={4}>
            <Card
              title={serviceContent[2].title}
              text={serviceContent[2].text}
            /></AnimationElement
          >
          <AnimationElement delayValue={5}>
            <Card
              title={serviceContent[3].title}
              text={serviceContent[3].text}
            /></AnimationElement
          >
        </Grid>
      </Stack>
    </SectionContainer>
  </PageContainer>

  <Spacer />

  <SectionContainer className="fade-in-out-on-scroll" id="contact">
    <Stack flex="column" gap="md" justify="center" align="center" width="full">
      <Stack
        flex="column"
        gap="md"
        justify="center"
        align="center"
        width="full"
      >
        <Heading titleSize="h2" align="center"
          ><AnimationElement>Get In Touch.</AnimationElement></Heading
        >
        <AnimationText align="center" delayValue={1}>
          If you are looking for web services and think we could be a good fit,
          get in touch by filling out the form below.
        </AnimationText>
      </Stack>
      <AnimationElement class="width-full align-center">
        <ContactForm />
      </AnimationElement>
    </Stack>
  </SectionContainer>

  <!-- <SectionContainer>
		<Stack
		direction="column"
					gap="md"
					horizontalAlign="left"
					verticalAlign="top"
		>
			<h2>What Our Customers Are Saying…</h2>
			<Grid columns={3}>
				{reviewsCollection.map((review) => (
					<Stack
					direction="column"
					gap="sm"
					horizontalAlign="left"
					verticalAlign="top"
					>
						<h3>{review.name}</h3>
						<p>{review.review}</p>
						{/* <p><strong>- {review.author}</strong></p> */}
					</Stack>
				))}
			</Grid>
		</Stack>
	</SectionContainer> -->
</BaseLayout>

<script>
  import "../scripts/vendor/web3forms.js";
</script>

<style>
  .desktop-hero {
    position: absolute;
    right: 0;
    top: 50%; /* 1. Moves the top edge to the middle of the screen */
    transform: translateY(-50%); /* 2. Centers it vertically perfectly */
    z-index: -1;
    width: 50vw;
    height: auto;
    transform-origin: right;
  }
  .mobile-hero {
    position: absolute;
    width: 100vw;
    top: 10;
    right: 0;
    z-index: -1;
    height: auto;
  }

  .about-section {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
</style>
