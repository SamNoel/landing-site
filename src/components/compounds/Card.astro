---
import Image from "@components/elements/Image.astro";

import type { HTMLAttributes } from "astro/types";
import {BASE_PAGE_PATH} from "@consts";

interface Props extends HTMLAttributes<"div"> {
  title?: string;
  text?: string;
  imageName?: string;
  linkText?: string;
  linkPageName?: string;
}

const {
  title = "Card Title",
  text = "Here is some text",
  imageName,
  linkPageName,
  linkText,
  ...props
} = Astro.props;
---

<div class="nws-card flex-column gap-xs justify-start" {...props}>
  {imageName && <Image imageName={imageName}
    alt=`Image for card with title of: ${title}`
    class="card-image"
    width={600}
    height={400}/>}

    <h3>{title}</h3>
    <p>{text}</p>
    {(linkPageName && linkText) && <a href={`${BASE_PAGE_PATH}${linkPageName}`}>{linkText}</a>}
</div>
