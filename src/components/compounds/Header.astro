---
import { Image } from "astro:assets";
import LogoImage from "@assets/logo.svg";
import { NAV_LINKS } from "@consts";

const { ...props } = Astro.props;
---

<header class="header" {...props}>
  <div class="nav-inner header-padding justify-between align-center">
    <!-- Logo -->
    <a href="/#home" class="logo-link">
      <Image
        src={LogoImage}
        alt="Noel Web Studio logo"
        width="24"
        format="svg"
        loading="eager"
        fetchpriority="high"
      />
      <p class="logo-text">Noel Web Studio</p>
    </a>

    <!-- Hamburger (mobile only) -->
    <button class="hamburger" aria-label="Toggle menu" aria-expanded="false">
      <span class="hamburger-top"></span>
      <span class="hamburger-middle"></span>
      <span class="hamburger-bottom"></span>
    </button>

    <!-- Nav -->
    <nav class="desktop-nav">
      {NAV_LINKS.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
  </div>

  <!-- Mobile menu (separate panel) -->
  <div id="mobileNav" class="mobile-nav">
    {
      NAV_LINKS.map((item) => (
        <a href={item.href} class="mobile-nav-links">
          {item.label}
        </a>
      ))
    }
  </div>
</header>

<script src="/src/scripts/header.js"></script>

<style>
  .header {
    box-sizing: border-box;
    width: 100%;
    background-color: var(--color-black);
    position: sticky;
    top: 0;
    z-index: 1000;
    transition: transform 0.2s ease-in-out;
    overflow-x: clip;
  }

  .nav-up {
    transform: translateY(-100%);
  }

  /* MAIN ROW */
  .nav-inner {
    max-width: var(--max-width);
    margin-inline: auto;

    display: flex;

    width: 100%;
    max-width: var(--max-width);
    box-sizing: border-box;
  }

  /* LOGO */
  .logo-link {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    gap: 16px;
    text-decoration: none;
  }

  .logo-link:hover {
    background-color: var(--color-black);
  }

  .logo-link p {
    font-weight: 400;
    color: white;
  }

  /* DESKTOP NAV */
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .desktop-nav a {
    text-decoration: none;
    white-space: nowrap;
  }

  /* HAMBURGER (hidden on desktop) */
  .hamburger {
    display: none;
    position: relative;
    justify-content: center;
    width: 24px;
    height: 24px;
    flex-direction: column;
    gap: 4px;

    background: none;
    border: none;
    cursor: pointer;
  }

  .hamburger span {
    width: 22px;
    height: 2px;
    background: var(--color-white);
    display: block;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
  }

  .hamburger-top.open {
    transform: translateY(6px) rotate(45deg);
    translate: 0 1px;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
  }

  .hamburger-middle.open {
    opacity: 0;
    /* transition:
      opacity 0.1s ease,
      transform 0.2s ease,
      visibility 0.1s; */
  }

  .hamburger-bottom.open {
    transform: translateY(-5px) rotate(-45deg);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
  }

  /* MOBILE MENU PANEL */
  .mobile-nav {
    display: flex;
    position: absolute;
    top: 90%;
    right: 0;
    width: 100%;
    height: calc(100vh - var(--vpadding-default) * 2 + 2vh);

    /* width: 100%; */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 16px;

    padding: 16px;
    background: var(--color-black);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-8px);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      visibility 0.2s;
  }

  .mobile-nav a {
    text-decoration: none;
    padding: 8px 16px;
    text-align: center;
    font-size: var(--text-500);
    line-height: 1.6;
    color: var(--color-white);
  }

  /* OPEN STATE */
  /* .header.menu-open .mobile-nav {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
  } */
  .mobile-nav.menu-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
  }

  /* =========================
   MOBILE
========================= */
  @media (max-width: 768px) {
    .header {
      overflow: visible;
    }
    .desktop-nav {
      display: none;
    }

    .hamburger {
      display: flex;
    }

    .logo-text {
      display: none;
    }
  }
</style>
