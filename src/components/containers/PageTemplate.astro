---
import BaseLayout from "@layouts/BaseLayout.astro";
import SectionContainer from "@components/containers/SectionContainer.astro";
import Stack from "@components/elements/Stack.astro";
import Divider from "@components/elements/Divider.astro";
import PageContainer from "@components/containers/PageContainer.astro";
import Button from "@components/elements/ButtonLink.astro";
import Card from "@components/compounds/Card.astro";
import Heading from "@components/elements/Heading.astro";
import Text from "@components/elements/Text.astro";
---

<BaseLayout title="Page" description="Page template">
  <PageContainer id="page" class="page-container">
    <SectionContainer>
      <Stack flex="column" gap="lg" justify="start" align="start">
        <Heading titleSize="h1">This is a new page.</Heading>
        <Text>
          You can use different components here to build out your page.
        </Text>
        <Button href="#" label="Button" variant="primary" />
      </Stack>
    </SectionContainer>

    <SectionContainer>
      <Divider />
    </SectionContainer>

    <SectionContainer class="fade-in-element" id="section">
      <Stack flex="row" gap="lg" justify="start" align="center">
        <Stack flex="column" gap="lg" justify="start" align="start">
          <Heading titleSize="h2">This is a section.</Heading>
          <Text>
            You can use different components here to build out your section.
          </Text>
        </Stack>
        <Card title="Card Title" text="This is a simple card component." />
      </Stack>
    </SectionContainer>
  </PageContainer>
</BaseLayout>
