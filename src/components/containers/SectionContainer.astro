---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"a"> {
  className?: string;
}

const { className = "", ...props } = Astro.props;
---

<!-- ============================================ --><!--                     SECTION                      --><!-- ============================================ -->
<section class=`section-container ${className} section-padding` {...props}>
  <slot />
</section>

<style>
  .section-container {
    min-width: 0;
    width: 100%;
    max-width: var(--max-width);
    scroll-margin-top: calc((var(--vpadding-md) * 2) + var(--vpadding-md));
    padding: var(--vpadding-default) var(--hpadding-default);
  }
</style>
