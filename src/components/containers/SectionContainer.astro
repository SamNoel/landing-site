---
import type { HTMLAttributes } from "astro/types";
import type { JustifyType, AlignType, WidthType } from "@consts";

interface Props extends HTMLAttributes<"a"> {
  className?: string;
  justify?: JustifyType;
  align?: AlignType;
  width?: WidthType;
}

const {
  className = "",
  justify = "center",
  align = "center",
  width = "full",
  ...props
} = Astro.props;
---

<!-- ============================================ --><!--                     SECTION                      --><!-- ============================================ -->
<section
  class=`section-container ${className} justify-${justify} align-${align} width-${width}`
  {...props}
>
  <slot />
</section>

<style>
  .section-container {
    display: flex;
    scroll-margin-top: calc((var(--vpadding-100) * 2) + var(--vpadding-100));
    padding: var(--vpadding-default) var(--hpadding-default);
  }
</style>
