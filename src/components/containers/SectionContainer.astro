---
import type { HTMLAttributes } from "astro/types";
import type {
  JustifyType,
  AlignType,
  WidthType,
  VPaddingSectionType,
  HPaddingSectionType,
} from "@consts";

interface Props extends HTMLAttributes<"a"> {
  className?: string;
  justify?: JustifyType;
  align?: AlignType;
  width?: WidthType;
  vpadding?: VPaddingSectionType;
  hpadding?: HPaddingSectionType;
}

const {
  className = "",
  justify = "center",
  align = "center",
  width = "full",
  vpadding = "md",
  hpadding = "md",
  ...props
} = Astro.props;
---

<!-- ============================================ --><!--                     SECTION                      --><!-- ============================================ -->
<section
  class=`section-container ${className} justify-${justify} align-${align} width-${width} vpad-section-${vpadding} hpad-section-${hpadding}`
  {...props}
>
  <slot />
</section>

<style>
  .section-container {
    display: flex;
    scroll-margin-top: calc((var(--vpadding-100) * 2) + var(--vpadding-100));
  }
</style>
