---
import "@styles/globals/defaults.css";
import type { HTMLAttributes } from "astro/types";
import type { AlignType, WidthType } from "@consts";

// Allow swapping the root element while maintaining type safety for that tag
export interface Props extends HTMLAttributes<"p" | "span" | "strong" | "em"> {
  textType?: "p" | "span" | "strong" | "em";
  align?: AlignType;
  maxWidth?: WidthType;
  classNames?: string;
}

const {
  textType = "p",
  align = "start",
  maxWidth = "normal",
  classNames = "",
  ...props
} = Astro.props;

// Render the title with the appropriate heading tag based on the titleSize prop
const TextTag = textType || "p";
---

<TextTag
  class=`text-${align} max-text-${maxWidth} ${classNames}`
  style="display: inline-block"
  ,
  {...props}
>
  <slot />
</TextTag>
