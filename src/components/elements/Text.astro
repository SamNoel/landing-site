---
import "@styles/globals/defaults.css";
import type { HTMLAttributes } from "astro/types";
import type { AlignType, WidthType } from "@consts";

// Allow swapping the root element while maintaining type safety for that tag
interface Props extends HTMLAttributes<"p" | "span" | "strong" | "em"> {
  as?: "p" | "span" | "strong" | "em";
  align?: AlignType;
  maxWidth?: WidthType;
}

const {
  as: Tag = "p",
  align = "left",
  maxWidth = "normal",
  ...props
} = Astro.props;
---

<Tag class=`text-${align} max-text-${maxWidth}` , {...props}>
  <slot />
</Tag>
