---
import type { HTMLAttributes } from "astro/types";
import type { WidthType, GapType } from "@consts";

interface Props extends HTMLAttributes<"div"> {
  gap?: GapType;
  width?: WidthType;
  className?: string;
}

const { className = "", gap = "md", width = "normal", ...props } = Astro.props;
---

<div class={`nws-grid ${className} gap-${gap} width-${width}`} {...props}>
  <slot />
</div>
