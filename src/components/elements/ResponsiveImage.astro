---
import { Picture, getImage } from "astro:assets";
import { BASE_IMAGE_PATH } from "@consts";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"picture"> {
  mobileImgUrl?: string;
  desktopImgUrl: string;
  alt: string;
  desktopClassNames?: string;
  mobileClassNames?: string;
  loading?: "lazy" | "eager";
}

/**
 * We want to be able to set:
 * desktop width
 * desktop height
 * mobile width
 * mobile height
 * ^^^ responsive
 * desktopImageSizing: fixed, fluid
 *  mobileImageSizing: fixed, fluid
 *
 * desktop image
 * mobile image
 *
 * alt
 *
 * position
 *
 * additional classes (for things like JS animations)
 */

const {
  mobileImgUrl = "",
  desktopImgUrl = "placeholder.webp",
  alt = "A placeholder image.",
  loading = "lazy",
  desktopClassNames = "",
  mobileClassNames = "",
  ...props
} = Astro.props;

const desktopImagePath = `${BASE_IMAGE_PATH}${desktopImgUrl}`;
const mobileImagePath = mobileImgUrl
  ? `${BASE_IMAGE_PATH}${mobileImgUrl}`
  : null;

// Gather all image paths from the assets folder
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/*.{jpeg,jpg,png,gif,webp}",
);

// Check if image exists in the glob
if (!images[desktopImagePath]) {
  throw new Error(`${desktopImagePath} does not exist in glob`);
}

if (mobileImagePath && !images[mobileImagePath]) {
  throw new Error(`${mobileImagePath} does not exist in glob`);
}
---

<!-- Mobile image -->{
  mobileImagePath && (
    <Picture
      src={images[mobileImagePath]()}
      formats={["avif", "webp"]}
      pictureAttributes={{ class: "mobile-only" }}
      class={mobileClassNames}
      alt={alt}
      layout="constrained"
      loading={loading}
      fetchpriority={loading == "eager" ? "high" : "auto"}
      {...props}
    />
  )
}

<!-- Desktop Image
 If there is a mobile image also, use desktop image with the media query. 
 Otherwise, use desktop image without the media query since it will be used
 for both desktop and mobile.
-->
{
  mobileImagePath ? (
    <Picture
      src={images[desktopImagePath]()}
      formats={["avif", "webp"]}
      alt={alt}
      layout="constrained"
      pictureAttributes={{ class: "desktop-only desktop" }}
      class={desktopClassNames}
      loading={loading}
      fetchpriority={loading == "eager" ? "high" : "auto"}
      {...props}
    />
  ) : (
    <Picture
      src={images[desktopImagePath]()}
      formats={["avif", "webp"]}
      alt={alt}
      layout="constrained"
      pictureAttributes={{ class: "desktop" }}
      class={desktopClassNames}
      loading={loading}
      fetchpriority={loading == "eager" ? "high" : "auto"}
      {...props}
    />
  )
}

<style>
  @media (min-width: 48.1rem) {
    .mobile-only {
      display: none;
    }
  }

  @media (max-width: 48rem) {
    .desktop-only {
      display: none;
    }
  }
</style>
