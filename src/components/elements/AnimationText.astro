// <div class="fade-in-line-wrapper" data-animate>
//   <Text
//     class=`fade-in-line ${classNames}`
//     style=`${style} --i:${delayValue}`
//     align={props.align}
//   >
//     {text}
//   </Text>)
// </div>
---

<div class="fade-in-line-wrapper" data-animate>
  <TextTag
    class=`fade-in-line text-${align} max-text-${maxWidth} ${classNames}`
    style=`display: inline-block; --i:${delayValue}`
    `
    ,
    {...props}
  >
    <slot />
  </TextTag>
</div>
