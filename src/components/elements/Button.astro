---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"button"> {
  classNames?: string;
  label: string;
  text: string;
  variant?: "primary" | "secondary";
}

const {
  type = "button",
  onclick = () => {},
  classNames = "",
  label = `A ${type} button`,
  text = "Button",
  variant = "primary",
  ...props
} = Astro.props;
---

<button
  type={type}
  class:list={["nws-button", classNames, "text-center", "button-text", variant]}
  {...props}
  aria-label={label}
  title={label}
>
  {text}
</button>
