---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"div"> {
  gap?: "sm" | "md" | "lg";
}

const { gap = "md", ...props } = Astro.props;
---

<div class=`.spacer spacer-${gap} max-full` {...props} aria-hidden="true"></div>

<style>
  .spacer-sm {
    height: 8rem;
  }

  .spacer-md {
    height: 12rem;
  }

  .spacer-lg {
    height: 16rem;
  }

  @media (max-width: 768px) {
    .spacer {
      height: 80px;
    }
  }
</style>
