---
import type { HTMLAttributes } from "astro/types";
import type { SpacerType } from "@consts";

interface Props extends HTMLAttributes<"div"> {
  gap?: SpacerType;
}

const { gap = "md", ...props } = Astro.props;
---

<div class=`.spacer spacer-${gap} max-full` {...props} aria-hidden="true"></div>
