---
/**
 * @component Stack Component
 *
 * @description This component is a container for elements that stack using flex.
 * Attributes can be set like row/column, gap, justify, align, and width. Custom
 * classes can be applied for custom styling.
 */

import type { HTMLAttributes } from "astro/types";
import type { JustifyType, AlignType, WidthType, GapType } from "@consts";

interface Props extends HTMLAttributes<"section"> {
  flex?: "row" | "column";
  gap?: GapType;
  justify?: JustifyType;
  align?: AlignType;
  width?: WidthType;
  classNames?: string;
}

const {
  flex = "column",
  gap = "md",
  justify = "start",
  align = "start",
  classNames = "",
  width = "normal",
  ...props
} = Astro.props;
---

<div
  class:list={[
    "nws-stack",
    `flex-${flex}`,
    `gap-${gap}`,
    `justify-${justify}`,
    `align-${align}`,
    `width-${width}`,
    `${classNames}`,
  ]}
  {...props}
>
  <slot />
</div>

<style>
  /* tablet */
  @media (max-width: 48rem) {
    .nws-stack {
      flex-direction: column;
    }
  }
</style>
