---
import type { HTMLAttributes } from "astro/types";
import type { JustifyType, AlignType, WidthType, GapType } from "@consts";

interface Props extends HTMLAttributes<"section"> {
  flex?: "row" | "column";
  gap?: GapType;
  justify?: JustifyType;
  align?: AlignType;
  width?: WidthType;
  className?: string;
}

const {
  flex = "column",
  gap = "md",
  justify = "start",
  align = "start",
  className = "",
  width = "normal",
  ...props
} = Astro.props;
---

<section
  class:list={[
    "nws-stack",
    `flex-${flex}`,
    `gap-${gap}`,
    `justify-${justify}`,
    `align-${align}`,
    `width-${width}`,
    `${className}`,
  ]}
  {...props}
>
  <slot />
</section>

<style>
  /* tablet */
  @media (max-width: 48rem) {
    .nws-stack {
      flex-direction: column;
    }
  }
</style>
