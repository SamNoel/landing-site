---
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  flex?: "row" | "column";
  gap?: "xs" | "sm" | "md" | "lg";
  justify?: "start" | "center" | "between" | "around" | "evenly";
  align?: "start" | "center" | "end" | "stretch";
  className?: string;
}

const {
  flex = "column",
  gap = "md",
  justify = "start",
  align = "start",
  className = "",
  ...props
} = Astro.props;
---

<section
  class:list={[
    "stack",
    `flex-${flex}`,
    `gap-${gap}`,
    `justify-${justify}`,
    `align-${align}`,
    `${className}`,
  ]}
  {...props}
>
  <slot />
</section>

<style>
  .stack {
    display: flex;
    max-width: 100%;
  }

  @media (max-width: 768px) {
    .stack {
      flex-direction: column;
    }
  }
</style>
