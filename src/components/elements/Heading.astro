---
import type { HTMLAttributes } from "astro/types";
import type { JustifyType, AlignType, WidthType } from "@consts";

interface Props extends HTMLAttributes<
  "h1" | "h2" | "h3" | "h4" | "h5" | "h6"
> {
  titleSize: "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  display?: boolean;
  align?: AlignType;
  maxWidth?: WidthType;
}

const {
  titleSize = "h1",
  display = false,
  align = "left",
  maxWidth = "normal",
  ...props
} = Astro.props;

// Render the title with the appropriate heading tag based on the titleSize prop
const HeadingTag = titleSize || "h2";
---

<HeadingTag class=`text-${align} ${display ? "display" : ""}` , {...props}
  ><slot /></HeadingTag
>
