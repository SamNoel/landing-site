---
import Heading from "@components/elements/Heading.astro";

const { ...props } = Astro.props;
---

<section class="hero" , {...props}>
  <div class="content-container fade-in-with-delay">
    <Heading titleSize="h1" display={false}>
      We build custom websites for small businesses.
    </Heading>
    <p>
      We're your all-in-one web partner. We build you a 100% custom website
      suited specifically for your business, with fast loading speeds and
      optimized content. Let us take the complication out of your web presence.
    </p>
  </div>
</section>

<style>
  .hero {
    padding: 0 0 64px 0;
    width: 100%;
    height: 80vh;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    position: relative;
  }

  .content-container {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--gap-300);
    z-index: 2;
    max-width: 390px;
  }

  .image {
    align-items: start;
  }

  @media (max-width: 768px) {
    .hero {
      padding: 0;
    }

    .image {
      width: 100%;
      height: auto;
    }

    .content-container {
      bottom: 0px;
      left: 0px;
      width: 100%;
    }
  }
</style>
