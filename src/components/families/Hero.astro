---
import Heading from "@components/elements/Heading.astro";
import Text from "@components/elements/Text.astro";
import Button from "@components/elements/Button.astro";
import ScrollIntoView from "@components/Animations/ScrollIntoView.astro";

const { ...props } = Astro.props;
---

<section class="hero" , {...props}>
  <div class="content-container">
    <Heading titleSize="h1" display={false}>
      <ScrollIntoView delay={1}>We build custom</ScrollIntoView>
      <ScrollIntoView delay={2}>websites for small</ScrollIntoView>
      <ScrollIntoView delay={3}>businesses.</ScrollIntoView>
    </Heading>
    <ScrollIntoView delay={4}>
      <Text>
        We're your all-in-one web partner. We build you a 100% custom website
        suited specifically for your business, with fast loading speeds and
        optimized content. Let us take the complication out of your web
        presence.
      </Text></ScrollIntoView
    >

    <!-- <Text align="center"
      ><AnimationElement delayValue={3.5}
        ><p>
          We're your all-in-one web partner. We build you a 100% custom website
          suited specifically for your business, with fast loading speeds and
          optimized content. Let us take the complication out of your web
          presence.
        </p></AnimationElement
      ></Text
    > -->
    <ScrollIntoView delay={5}
      ><Button href="#contact" label="Get in Touch" /></ScrollIntoView
    >
  </div>
</section>

<style>
  .hero {
    padding: 0 0 64px 0;
    width: 100%;
    height: 80vh;
    display: flex;
    flex-direction: row;
    justify-content: flex-start;
    align-items: center;
    position: relative;
  }

  .content-container {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--gap-300);
    z-index: 2;
    max-width: 400px;
  }

  .image {
    align-items: start;
  }

  /* tablet */
  @media (max-width: 48rem) {
    .hero {
      padding: 0;
      align-items: flex-end;
    }

    .image {
      width: 100%;
      height: auto;
    }

    .content-container {
      bottom: 0px;
      left: 0px;
      width: 100%;
    }
  }
</style>
