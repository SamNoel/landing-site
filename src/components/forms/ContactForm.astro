---
/**
 * A simple contact form
 */
import Button from "@components/elements/Button.astro";
---

<form id="contact-form" class="contact-form">
  <input
    type="hidden"
    name="access_key"
    value="92f04ba0-23e2-43c0-bbde-e883621269a0"
  />

  <div class="cf-field-wrapper">
    <label for="input_name" class="cf-label">Name</label>
    <input
      id="input_name"
      class="cf-field bg-muted"
      type="text"
      name="name"
      required
      placeholder="John Doe"
    />
  </div>

  <div class="cf-field-wrapper">
    <label for="input_email" class="cf-label">Email Address</label>
    <input
      id="input_email"
      class="cf-field bg-muted"
      type="text"
      name="email"
      required
      placeholder="example@email.com"
    />
  </div>

  <div class="cf-field-wrapper">
    <label for="input_message" class="cf-label">Message</label>
    <textarea
      id="input_message"
      class="cf-field bg-muted"
      name="message"
      id="message"
      required
      placeholder="How can we help your business?"></textarea>
  </div>

  <!-- hp field -->
  <input
    type="text"
    name="website"
    class="hp-field"
    tabindex="-1"
    autocomplete="off"
  />

  <Button type="submit" text="Send" label="Submit button" />
  <div id="result" class="result-message"></div>
</form>

<style>
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 24px;
    border: 1px solid var(--color-grey-300);
    border-radius: 3px;
    padding: 2rem;
    background-color: var(--color-black);
    width: 100%;
  }

  .cf-field-wrapper {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .cf-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 8px 16px;
    color: var(--s-color-type-h);
    font-size: var(--s-size-type-p);
  }

  .cf-label {
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: 0.04em;
    color: var(--color-grey-200);
  }

  .result-message {
    color: var(--color-white);
  }

  .hp-field {
    position: absolute;
    left: -9999px;
  }
</style>

<script src="/src/scripts/contactForm.js"></script>
